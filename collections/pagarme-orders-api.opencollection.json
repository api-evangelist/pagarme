{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pagar.me Core Anticipations Orders API",
    "version": "5"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pagar.me/core/v5/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of orders."
        },
        {
          "info": {
            "name": "Create order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pagar.me/core/v5/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an order, bundling customer, items, and payments. Generates one or more charges."
        },
        {
          "info": {
            "name": "Get order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pagar.me/core/v5/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get order"
        },
        {
          "info": {
            "name": "Close or reopen an order",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.pagar.me/core/v5/orders/:order_id/closed",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Close or reopen an order"
        }
      ]
    }
  ],
  "bundled": true
}